{
  "agent": {
    "run_as_user": "root",
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/carecircle/nginx/access",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 90,
            "log_group_class": "STANDARD"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/carecircle/nginx/error",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 90,
            "log_group_class": "STANDARD"
          }
        ]
      },
      "journald": {
        "collect_list": [
          {
            "units": ["gunicorn.service"],
            "priority": "info",
            "log_group_name": "/carecircle/gunicorn",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 90,
            "log_group_class": "STANDARD"
          },
          {
            "units": ["celery-worker.service"],
            "priority": "info",
            "log_group_name": "/carecircle/celery",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 90,
            "log_group_class": "STANDARD"
          }
        ]
      }
    }
  }
}
