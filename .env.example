# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL for local/dev/prod, SQLite fallback)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=carecircle_local
DB_USER=carecircle
DB_PASSWORD=carecircle_local_pass
DB_HOST=localhost
DB_PORT=5432

# RDS SSL (required for AWS RDS connections)
DB_SSLMODE=require

# Environment switching (local/dev/prod)
DJANGO_SETTINGS_MODULE=backend.settings
ENVIRONMENT=local

# JWT (optional overrides)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# GoHighLevel CRM
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_SHARED_SECRET=
GHL_LOCATION_ID=
GHL_PRIVATE_TOKEN=

# UniteUs scraper
UNITEUS_USERNAME=
UNITEUS_PASSWORD=
