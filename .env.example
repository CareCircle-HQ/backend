# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: DJANGO_ALLOWED_HOSTS=www.carecircleinternal.com,carecircleinternal.com

# CSRF trusted origins (scheme + host). Needed for the admin/browsable API
# over HTTPS in production.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Production: DJANGO_CSRF_TRUSTED_ORIGINS=https://www.carecircleinternal.com

# Database (PostgreSQL for local/dev/prod, SQLite fallback)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=carecircle_local
DB_USER=carecircle
DB_PASSWORD=carecircle_local_pass
DB_HOST=localhost
DB_PORT=5432

# RDS SSL (required for AWS RDS connections)
DB_SSLMODE=require

# Environment switching (local/dev/prod)
DJANGO_SETTINGS_MODULE=backend.settings
ENVIRONMENT=local

# JWT (optional overrides)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Field encryption (REQUIRED at runtime). Fernet key used to encrypt sensitive
# columns at rest, e.g. captured Unite Us access/refresh tokens. Without it,
# reading/writing encrypted fields raises ImproperlyConfigured (e.g. the Unite
# Us credential-capture endpoint will 500). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it STABLE: changing it makes previously-encrypted values unreadable.
FIELD_ENCRYPTION_KEY=

# CORS (only used when DJANGO_DEBUG=False; in DEBUG all origins are allowed).
# List web browser origins that call the API (e.g. a web frontend). Chrome
# extension origins (chrome-extension://...) are allowed automatically via
# CORS_ALLOWED_ORIGIN_REGEXES, so they do NOT need to be listed here.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production example:
# CORS_ALLOWED_ORIGINS=https://www.carecircleinternal.com

# GoHighLevel CRM
# MVP phase: outbound syncing to the external CRM is hard-disconnected. Leave
# CRM_SYNC_DISCONNECTED=true so no data leaves our API. To re-enable the GHL
# mirror later, set it to false AND set CRM_SYNC_ENABLED=true + token + location.
CRM_SYNC_DISCONNECTED=true
CRM_SYNC_ENABLED=false
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_SHARED_SECRET=
GHL_LOCATION_ID=
GHL_PRIVATE_TOKEN=

# CallTools dialer
CALLTOOLS_API_TOKEN=
CALLTOOLS_API_BASE=https://east-1.calltools.io/api

# UniteUs scraper
UNITEUS_USERNAME=
UNITEUS_PASSWORD=
